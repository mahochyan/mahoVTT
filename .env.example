# First launch uses the offline rules demo. Change to openai, or use AI Settings in the web UI.
AI_PROVIDER=mock
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_MODEL=
AI_API_KEY=
AI_JSON_MODE=off
AI_TIMEOUT_MS=45000
# Optional: default is 3000. Only binds to 127.0.0.1.
PORT=3000
# Optional: otherwise saves are under this project's data/ directory.
# SAGAS_DATA_DIR=E:\VTT\sagas\data
